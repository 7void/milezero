# Database Connection (PostgreSQL or SQLite file URL)
DATABASE_URL="postgresql://milezero:milezeropassword@localhost:5432/milezerodb?schema=public"

# NestJS Server Configuration
PORT=3001
NODE_ENV=development
JWT_SECRET="milezero-super-secret-jwt-key-2026-production-grade"
JWT_EXPIRES_IN="7d"

# Mapbox Public Access Token (for frontend map rendering)
# Obtain a free token from https://mapbox.com
VITE_MAPBOX_TOKEN=""

# Frontend API URL
VITE_API_BASE_URL="http://localhost:3001/api"

# ==============================================================================
# Notification Providers (Optional - falls back to safe audit logs if omitted)
# ==============================================================================

# Email Provider: Resend (Recommended - https://resend.com)
RESEND_API_KEY=""
EMAIL_FROM_ADDRESS="onboarding@resend.dev"

# Email Provider: SendGrid (Alternative - https://sendgrid.com)
SENDGRID_API_KEY=""

# Email Provider: Generic Webhook URL
EMAIL_WEBHOOK_URL=""

